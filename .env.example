# Копирай като .env и попълни. НИКОГА не commit-вай .env.
# Генериране на тайни:  openssl rand -hex 32
# Паролите за БД влизат в DATABASE_URL → ползвай само URL-безопасни символи (hex).

# --- Compose ---
# В production разкоментирай, за да не се зарежда docker-compose.override.yml:
# COMPOSE_FILE=docker-compose.yml

# --- Postgres (един инстанс, две бази) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
APP_DB_USER=barbershop
APP_DB_PASSWORD=change-me-app
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-n8n
# Postgres се публикува само на loopback на хоста (на сървъра: достъп през SSH тунел)
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
# За npm скриптове от хоста (db:generate/db:seed/тестове):
DATABASE_URL=postgres://barbershop:change-me-app@127.0.0.1:5432/barbershop
TEST_DATABASE_URL=postgres://barbershop:change-me-app@127.0.0.1:5432/barbershop_test
DB_POOL_MAX=10

# --- Приложение ---
# Docker образ на app (публикува се в GHCR от CI). При обновяване смени тага.
APP_IMAGE=ghcr.io/iushev/barber
APP_IMAGE_TAG=0.0.1
APP_BIND=0.0.0.0
APP_PORT=3000
# Публичният адрес (за manageUrl и линкове). Зад TLS: https://example.bg
PUBLIC_BASE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Europe/Sofia
CURRENCY=EUR
# true зад HTTPS (външен TLS терминатор); false само локално по http.
COOKIE_SECURE=false
# true само ако пред приложението има доверен прокси, който задава X-Forwarded-*.
TRUST_PROXY=false
# true само когато сайтът се обслужва изцяло по HTTPS.
ENABLE_HSTS=false

# --- Правила за записване ---
SLOT_STEP_MIN=15
MIN_LEAD_MIN=60
BOOKING_HORIZON_DAYS=60
MAX_ACTIVE_BOOKINGS_PER_PHONE=3
CANCEL_CUTOFF_HOURS=2
# Опити за записване: на клиент (IP за формата, chat сесия за агента) за час и на телефон за ден
BOOKING_RATE_LIMIT_PER_CLIENT_HOUR=10
BOOKING_RATE_LIMIT_PER_PHONE_DAY=6

# --- Първи администратор (създава се при старт, ако няма такъв) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-12-chars

# --- Agent API (същият ключ се въвежда като Header Auth credential в n8n) ---
AGENT_API_KEY=change-me-openssl-rand-hex-32-xxxxxxxx
AGENT_API_RATE_LIMIT_PER_MIN=120
# Колко часа се пазят Idempotency-Key и отговорът към тях (съдържа manageUrl)
IDEMPOTENCY_TTL_HOURS=24

# --- n8n ---
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://n8n:5678/
N8N_EDITOR_BIND=127.0.0.1
N8N_EDITOR_PORT=5678
N8N_EXECUTIONS_MAX_AGE_HOURS=24
# Chat Trigger (вътрешен адрес; <id> е webhookId от workflow-а, задава се в етап 6)
N8N_CHAT_URL=http://n8n:5678/webhook/booking-agent/chat
N8N_CHAT_USER=chat
N8N_CHAT_PASSWORD=change-me-chat
# Служебен webhook за изтриване на чат история (GDPR)
N8N_CHAT_PURGE_URL=http://n8n:5678/webhook/chat-purge
# Ограничения на чата (разход към OpenAI)
CHAT_RATE_LIMIT_PER_MIN=10
CHAT_RATE_LIMIT_PER_DAY=150
CHAT_MAX_MESSAGES_PER_SESSION=60
CHAT_TIMEOUT_MS=90000
# Workflow-ите и credentials се внасят автоматично от услугата n8n-setup при всеки deploy.
# OPENAI_API_KEY е по избор и НЕ е env на app: ключът се пази криптиран като credential в n8n.
# Без него въведете ключа веднъж в редактора (Credentials → „Barber · OpenAI“) или пуснете
# OPENAI_API_KEY=sk-... ./scripts/n8n/setup.sh. В Portainer може да е променлива на стека.
# OPENAI_MODEL=gpt-4.1-mini
# N8N_SETUP_IMAGE=ghcr.io/iushev/barber-n8n-setup   # същият таг като APP_IMAGE_TAG

# --- Демо данни ---
# Seed отказва срещу production, освен ако не е yes.
SEED_ALLOW_PRODUCTION=no

# --- Лични данни ---
# Резервации, приключили преди повече от N месеца, се анонимизират автоматично
DATA_RETENTION_MONTHS=24
